{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinTTS",
  "version": "2.0.0",
  "identifier": "com.biglexj.wintts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WinTTS — Local Speech",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../Image/Square44x44Logo.png",
      "../Image/Square150x150Logo.png",
      "../Image/app_icon.ico"
    ]
  },
  "plugins": {}
}
