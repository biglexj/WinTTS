<Window x:Class="WinTTS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTTS — Local Speech"
        Width="1120" Height="760" MinWidth="860" MinHeight="620"
        Icon="/Icon/app_icon.ico"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <Image Source="/Icon/app_icon.ico" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="WinTTS" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="  ·  Local Speech" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,5,7,5">
                    <Button Style="{StaticResource GhostButton}" Width="38" Click="Minimize_Click"
                            ToolTip="Minimizar" AutomationProperties.Name="Minimizar ventana">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" Data="M 3,8 L 13,8"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Width="38" Click="Maximize_Click"
                            ToolTip="Maximizar o restaurar" AutomationProperties.Name="Maximizar o restaurar ventana">
                        <Path x:Name="MaximizeIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Data="M 3,3 L 13,3 L 13,13 L 3,13 Z"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Width="38" Click="Close_Click"
                            Foreground="{StaticResource DangerBrush}" ToolTip="Cerrar"
                            AutomationProperties.Name="Cerrar ventana">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" Data="M 3,3 L 13,13 M 13,3 L 3,13"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,8,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Narración" Foreground="{StaticResource AccentBrush}"
                                       FontSize="25" FontWeight="Bold"/>
                            <TextBlock Text="Ajusta cómo quieres escuchar y exportar el texto."
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <TextBlock Text="VOZ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="VoiceSelector" DisplayMemberPath="Name"
                                      SelectionChanged="VoiceSelector_SelectionChanged"/>

                            <TextBlock Text="VOLUMEN" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}%}"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="VELOCIDAD" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=RateSlider, StringFormat={}{0:+0;-0;0}}"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="TONO" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                <Slider x:Name="PitchSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=PitchSlider, StringFormat={}{0:+0;-0;0}}"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Margin="0,20,0,16" Background="{StaticResource BorderBrush}"/>

                            <Button x:Name="PlayPauseButton" Content="Reproducir" Style="{StaticResource PrimaryButton}"
                                    Height="48" Click="PlayPause_Click" AutomationProperties.Name="Reproducir texto"/>
                            <Button x:Name="StopButton" Content="Detener" Style="{StaticResource DangerButton}"
                                    Height="44" Margin="0,10,0,0" Click="StopSpeech_Click" IsEnabled="False"/>
                            <Button x:Name="ExportButton" Content="Exportar WAV" Style="{StaticResource BaseButton}"
                                    Height="44" Margin="0,10,0,0" Click="ExportWave_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Editor de narración" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Selecciona texto para leerlo o marcarlo como omitido."
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="DocumentStatsText" Text="0 palabras · ~0 min"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <Button Content="Leer selección" Style="{StaticResource BaseButton}" Margin="0,0,8,8"
                                    Click="ReadSelection_Click" ToolTip="Lee únicamente el texto seleccionado"/>
                            <Button Content="Omitir selección" Style="{StaticResource BaseButton}" Margin="0,0,8,8"
                                    Click="SkipSelection_Click" ToolTip="El fragmento marcado no se leerá ni exportará"/>
                            <Button Content="Volver a incluir" Style="{StaticResource BaseButton}" Margin="0,0,8,8"
                                    Click="IncludeSelection_Click"/>
                            <Button Content="Limpiar omisiones" Style="{StaticResource BaseButton}" Margin="0,0,0,8"
                                    Click="ClearSkips_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <RichTextBox x:Name="InputEditor" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentBrush}"
                                         FontSize="16" Padding="14" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextChanged="InputEditor_TextChanged"
                                         IsReadOnly="True" SpellCheck.IsEnabled="False"
                                         AutomationProperties.Name="Editor de narración">
                                <RichTextBox.CommandBindings>
                                    <CommandBinding Command="ApplicationCommands.Paste"
                                                    CanExecute="InputEditor_PasteCanExecute"
                                                    Executed="InputEditor_PasteExecuted"/>
                                </RichTextBox.CommandBindings>
                                <FlowDocument PagePadding="0" LineHeight="24">
                                    <Paragraph/>
                                </FlowDocument>
                            </RichTextBox>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="MarkdownPreviewToggle" Content="Vista Markdown"
                                          IsChecked="True" Style="{StaticResource ModeToggle}"
                                          Click="MarkdownPreviewToggle_Click"
                                          ToolTip="Alterna entre el documento renderizado y el código Markdown editable"
                                          AutomationProperties.Name="Activar o desactivar vista previa Markdown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Border Width="12" Height="12" CornerRadius="3"
                                        Background="{StaticResource SkippedBackgroundBrush}"
                                        BorderBrush="{StaticResource SkippedBrush}" BorderThickness="1"
                                        Margin="0,2,7,0"/>
                                <TextBlock Text="Ámbar: omitido en lectura y exportación"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StateIndicator" Width="8" Height="8" Fill="{StaticResource DisabledBrush}" Margin="0,0,9,0"/>
                    <TextBlock x:Name="StatusText" Text="Listo" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" x:Name="SpeechProgressBar" Height="5" Minimum="0" Maximum="100"
                             Value="0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource SurfaceRaisedBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
